@@ -1553,6 +1601,31 @@ async fn handle_alter_logical_table_tasks(
     })
 }
 
+async fn handle_drop_logical_table_tasks(
+    ddl_manager: &DdlManager,
+    drop_table_tasks: Vec<DropTableTask>,
+    procedure_context: ProcedureContext,
+) -> Result<SubmitDdlTaskResponse> {
+    ensure!(
+        !drop_table_tasks.is_empty(),
+        EmptyDdlTasksSnafu {
+            name: "drop logical tables"
+        }
+    );
+    let num_logical_tables = drop_table_tasks.len();
+
+    let (id, _) = ddl_manager
+        .submit_drop_logical_table_tasks(drop_table_tasks, procedure_context)
+        .await?;
+
+    info!("{num_logical_tables} logical tables are dropped via procedure_id {id:?}");
+
+    Ok(SubmitDdlTaskResponse {
+        key: id.to_string().into(),
+        ..Default::default()
+    })
+}
