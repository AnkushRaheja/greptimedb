+/// Drops logical tables of the same physical table in a single procedure.
+///
+/// All the tasks are validated before any metadata is deleted. The logical tables
+/// share the physical regions, so the physical regions are registered as operating
+/// only once for the whole batch.
+pub struct DropLogicalTablesProcedure {
+    pub context: DdlContext,
+    pub data: DropLogicalTablesData,
+    /// The guards of the physical regions hosting the dropping logical regions.
+    pub(crate) dropping_regions: Vec<OperatingRegionGuard>,
+}
+
+impl DropLogicalTablesProcedure {
+    pub const TYPE_NAME: &'static str = "metasrv-procedure::DropLogicalTables";
+
+    pub fn new(
+        tasks: Vec<DropTableTask>,
+        physical_table_id: Option<TableId>,
+        context: DdlContext,
+    ) -> Self {
+        Self {
+            context,
+            data: DropLogicalTablesData {
+                state: DropLogicalTablesState::Prepare,
+                tasks,
+                physical_table_id,
+                tables: vec![],
+                physical_region_routes: vec![],
+            },
+            dropping_regions: vec![],
+        }
+    }
+
+    pub fn from_json(json: &str, context: DdlContext) -> ProcedureResult<Self> {
+        let data = serde_json::from_str(json).context(FromJsonSnafu)?;
+        Ok(Self {
+            context,
+            data,
+            dropping_regions: vec![],
+        })
+    }
+
+    /// Validates all the tasks and resolves the logical tables to drop.
+    ///
+    /// - Skips the missing tables if `drop_if_exists` is `true`, otherwise fails the batch.
+    /// - Skips the duplicate tables.
+    /// - Ensures all the tables are logical tables of the locked physical table.
+    pub(crate) async fn on_prepare(&mut self) -> Result<Status> {
+        let table_name_keys = self
+            .data
+            .tasks
+            .iter()
+            .map(|task| TableNameKey::new(&task.catalog, &task.schema, &task.table))
+            .collect::<Vec<_>>();
+        let table_name_values = self
+            .context
+            .table_metadata_manager
+            .table_name_manager()
+            .batch_get(table_name_keys)
+            .await?;
+
+        let mut dropping_table_ids = HashSet::with_capacity(self.data.tasks.len());
+        let mut tables = Vec::with_capacity(self.data.tasks.len());
+        for (task, value) in self.data.tasks.iter().zip(table_name_values) {
+            let Some(value) = value else {
+                ensure!(
+                    task.drop_if_exists,
+                    error::TableNotFoundSnafu {
+                        table_name: task.table_ref().to_string(),
+                    }
+                );
+                continue;
+            };
+            // Locks are fixed at submission, the table may be recreated in between.
+            ensure!(
+                value.table_id() == task.table_id,
+                error::UnexpectedSnafu {
+                    err_msg: format!(
+                        "table {} (id {}) is not covered by the procedure locks; retry the statement",
+                        task.table_ref(),
+                        value.table_id()
+                    ),
+                }
+            );
+            if dropping_table_ids.insert(task.table_id) {
+                tables.push(task.clone());
+            }
+        }
+
+        if tables.is_empty() {
+            info!("No logical table to drop, all the tables are not found");
+            return Ok(Status::done());
+        }
+
+        let table_ids = tables.iter().map(|task| task.table_id).collect::<Vec<_>>();
+        let table_routes = self
+            .context
+            .table_metadata_manager
+            .table_route_manager()
+            .table_route_storage()
+            .batch_get(&table_ids)
+            .await?;
+        let mut physical_table_id = None;
+        for (task, table_route) in tables.iter().zip(table_routes) {
+            let table_route = table_route.context(error::TableRouteNotFoundSnafu {
+                table_id: task.table_id,
+            })?;
+            let TableRouteValue::Logical(table_route) = table_route else {
+                return error::DropLogicalTablesInvalidArgumentsSnafu {
+                    err_msg: format!("table {} is not a logical table", task.table_ref()),
+                }
+                .fail();
+            };
+            let current = table_route.physical_table_id();
+            match physical_table_id {
+                None => physical_table_id = Some(current),
+                Some(physical_table_id) => ensure!(
+                    physical_table_id == current,
+                    error::DropLogicalTablesInvalidArgumentsSnafu {
+                        err_msg: "All the tables should have the same physical table id",
+                    }
+                ),
+            }
+        }
+        // Safety: `tables` is not empty.
+        let physical_table_id = physical_table_id.unwrap();
+        ensure!(
+            self.data.physical_table_id == Some(physical_table_id),
+            error::UnexpectedSnafu {
+                err_msg: format!(
+                    "physical table {physical_table_id} is not covered by the procedure locks; retry the statement"
+                ),
+            }
+        );
+
+        let (_, physical_table_route) = self
+            .context
+            .table_metadata_manager
+            .table_route_manager()
+            .get_physical_table_route(physical_table_id)
+            .await?;
+
+        self.data.tables = tables;
+        self.data.physical_region_routes = physical_table_route.region_routes;
+        self.data.state = DropLogicalTablesState::DeleteMetadata;
+        Ok(Status::executing(true))
+    }
+
+    /// Registers the physical regions as operating if they are not registered.
+    fn register_dropping_regions(&mut self) -> Result<()> {
+        if !self.dropping_regions.is_empty() {
+            return Ok(());
+        }
+
+        let dropping_regions = operating_leader_region_roles(&self.data.physical_region_routes);
+        let mut dropping_region_guards = Vec::with_capacity(dropping_regions.len());
+        for (region_id, datanode_id, role) in dropping_regions {
+            let guard = self
+                .context
+                .memory_region_keeper
+                .register_with_role(datanode_id, region_id, role)
+                .context(error::RegionOperatingRaceSnafu {
+                    region_id,
+                    peer_id: datanode_id,
+                })?;
+            dropping_region_guards.push(guard);
+        }
+
+        self.dropping_regions = dropping_region_guards;
+        Ok(())
+    }
+
+    pub(crate) async fn on_delete_metadata(&mut self) -> Result<Status> {
+        self.register_dropping_regions()?;
+        let physical_table_id = self.data.physical_table_id()?;
+        let tables = self.data.table_ids_and_names();
+        self.context
+            .table_metadata_manager
+            .delete_logical_tables_metadata(physical_table_id, &tables)
+            .await?;
+        info!(
+            "Deleted metadata for logical tables {:?} of physical table {physical_table_id}",
+            tables
+                .iter()
+                .map(|(table_id, _)| table_id)
+                .collect::<Vec<_>>()
+        );
+
+        self.data.state = DropLogicalTablesState::InvalidateTableCache;
+        Ok(Status::executing(true))
+    }
+
+    async fn on_invalidate_table_cache(&mut self) -> Result<Status> {
+        let cache_idents = self
+            .data
+            .tables
+            .iter()
+            .flat_map(|task| {
+                [
+                    CacheIdent::TableName(task.table_name()),
+                    CacheIdent::TableId(task.table_id),
+                ]
+            })
+            .collect::<Vec<_>>();
+        let ctx = CacheContext {
+            subject: Some(format!(
+                "Invalidate table cache by dropping logical tables, physical_table_id: {:?}",
+                self.data.physical_table_id,
+            )),
+        };
+        self.context
+            .cache_invalidator
+            .invalidate(&ctx, &cache_idents)
+            .await?;
+
+        self.data.state = DropLogicalTablesState::DatanodeDropRegions;
+        Ok(Status::executing(true))
+    }
+
+    async fn on_datanode_drop_regions(&mut self, retrying: bool) -> Result<Status> {
+        if retrying {
+            // The peer addresses may change during retries,
+            // so we always remap the region routes.
+            self.context
+                .table_metadata_manager
+                .table_route_manager()
+                .table_route_storage()
+                .remap_region_routes(&mut self.data.physical_region_routes)
+                .await?;
+        }
+
+        let region_routes = &self.data.physical_region_routes;
+        let node_manager = &self.context.node_manager;
+        let leader_region_registry = &self.context.leader_region_registry;
+        let drop_regions = self.data.tables.iter().map(|task| {
+            let executor =
+                DropTableExecutor::new(task.table_name(), task.table_id, task.drop_if_exists);
+            async move {
+                executor
+                    .on_drop_regions(
+                        node_manager,
+                        leader_region_registry,
+                        region_routes,
+                        false,
+                        false,
+                        false,
+                    )
+                    .await
+            }
+        });
+        try_join_all(drop_regions).await?;
+        self.context
+            .deregister_failure_detectors(convert_region_routes_to_detecting_regions(region_routes))
+            .await;
+
+        self.data.state = DropLogicalTablesState::DeleteTombstone;
+        Ok(Status::executing(true))
+    }
+
+    async fn on_delete_metadata_tombstone(&mut self) -> Result<Status> {
+        let physical_table_id = self.data.physical_table_id()?;
+        let tables = self.data.table_ids_and_names();
+        self.context
+            .table_metadata_manager
+            .delete_logical_tables_metadata_tombstone(physical_table_id, &tables)
+            .await?;
+
+        self.dropping_regions.clear();
+        Ok(Status::done())
+    }
+}
+
+#[async_trait]
+impl Procedure for DropLogicalTablesProcedure {
+    fn type_name(&self) -> &str {
+        Self::TYPE_NAME
+    }
+
+    fn recover(&mut self) -> ProcedureResult<()> {
+        // Only registers regions if the metadata is deleted.
+        let register_operating_regions = matches!(
+            self.data.state,
+            DropLogicalTablesState::DeleteMetadata
+                | DropLogicalTablesState::InvalidateTableCache
+                | DropLogicalTablesState::DatanodeDropRegions
+        );
+        if register_operating_regions {
+            self.register_dropping_regions()
+                .map_err(BoxedError::new)
+                .context(ExternalSnafu {
+                    clean_poisons: false,
+                })?;
+        }
+
+        Ok(())
+    }
+
+    async fn execute(&mut self, ctx: &ProcedureContext) -> ProcedureResult<Status> {
+        let state = &self.data.state;
+        let _timer = metrics::METRIC_META_PROCEDURE_DROP_TABLES
+            .with_label_values(&[state.as_ref()])
+            .start_timer();
+
+        match self.data.state {
+            DropLogicalTablesState::Prepare => self.on_prepare().await,
+            DropLogicalTablesState::DeleteMetadata => self.on_delete_metadata().await,
+            DropLogicalTablesState::InvalidateTableCache => self.on_invalidate_table_cache().await,
+            DropLogicalTablesState::DatanodeDropRegions => {
+                let retrying = ctx.is_retrying().await.unwrap_or(false);
+                self.on_datanode_drop_regions(retrying).await
+            }
+            DropLogicalTablesState::DeleteTombstone => self.on_delete_metadata_tombstone().await,
+        }
+        .map_err(map_to_procedure_error)
+    }
+
+    fn dump(&self) -> ProcedureResult<String> {
+        serde_json::to_string(&self.data).context(ToJsonSnafu)
+    }
+
+    fn lock_key(&self) -> LockKey {
+        // CatalogLock, SchemaLock,
+        // TableNameLock(s), TableLock(s)
+        let mut lock_key = Vec::with_capacity(4 * self.data.tasks.len() + 1);
+        for task in &self.data.tasks {
+            lock_key.push(CatalogLock::Read(&task.catalog).into());
+            lock_key.push(SchemaLock::read(&task.catalog, &task.schema).into());
+            lock_key.push(TableNameLock::new(&task.catalog, &task.schema, &task.table).into());
+            lock_key.push(TableLock::Write(task.table_id).into());
+        }
+        // Prevents the physical table from being dropped. The physical table itself
+        // can't be a target of the batch, it will be rejected in `Prepare`.
+        if let Some(physical_table_id) = self.data.physical_table_id
+            && self
+                .data
+                .tasks
+                .iter()
+                .all(|task| task.table_id != physical_table_id)
+        {
+            lock_key.push(TableLock::Read(physical_table_id).into());
+        }
+
+        LockKey::new(lock_key)
+    }
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+pub struct DropLogicalTablesData {
+    pub state: DropLogicalTablesState,
+    pub tasks: Vec<DropTableTask>,
+    /// The physical table resolved at submission.
+    pub physical_table_id: Option<TableId>,
+    /// The deduplicated logical tables to drop, resolved in `Prepare`.
+    pub tables: Vec<DropTableTask>,
+    pub physical_region_routes: Vec<RegionRoute>,
+}
+
+impl DropLogicalTablesData {
+    fn physical_table_id(&self) -> Result<TableId> {
+        self.physical_table_id.context(error::UnexpectedSnafu {
+            err_msg: "physical table id is missing in the drop logical tables procedure",
+        })
+    }
+
+    fn table_ids_and_names(&self) -> Vec<(TableId, TableName)> {
+        self.tables
+            .iter()
+            .map(|task| (task.table_id, task.table_name()))
+            .collect()
+    }
+}
+
+/// The state of drop logical tables.
+#[derive(Debug, Serialize, Deserialize, AsRefStr, PartialEq)]
+pub enum DropLogicalTablesState {
+    /// Validates the tasks and resolves the logical tables
+    Prepare,
+    /// Deletes metadata logically
+    DeleteMetadata,
+    /// Invalidates table cache
+    InvalidateTableCache,
+    /// Drops logical regions on Datanode
+    DatanodeDropRegions,
+    /// Deletes metadata tombstone permanently
+    DeleteTombstone,
+}
