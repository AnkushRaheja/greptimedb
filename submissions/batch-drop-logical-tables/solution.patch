+    /// Deletes metadata for logical tables of the same physical table **logically**.
+    /// The caller MUST ensure it has the exclusive access to all the `TableNameKey`s.
+    pub async fn delete_logical_tables_metadata(
+        &self,
+        physical_table_id: TableId,
+        tables: &[(TableId, TableName)],
+    ) -> Result<()> {
+        let keys = self.logical_tables_metadata_keys(physical_table_id, tables)?;
+        self.tombstone_manager.create(keys).await.map(|_| ())
+    }
+
+    /// Deletes the metadata tombstones of logical tables of the same physical table **permanently**.
+    /// The caller MUST ensure it has the exclusive access to all the `TableNameKey`s.
+    pub async fn delete_logical_tables_metadata_tombstone(
+        &self,
+        physical_table_id: TableId,
+        tables: &[(TableId, TableName)],
+    ) -> Result<()> {
+        let keys = self.logical_tables_metadata_keys(physical_table_id, tables)?;
+        let markers = tables
+            .iter()
+            .flat_map(|(table_id, _)| {
+                [
+                    dropped_at_key(*table_id),
+                    retention_expires_at_key(*table_id),
+                    drop_generation_key(*table_id),
+                    purging_key(*table_id),
+                ]
+            })
+            .collect();
+        self.tombstone_manager
+            .delete_with_markers(keys, markers)
+            .await
+            .map(|_| ())
+    }
+
+    fn logical_tables_metadata_keys(
+        &self,
+        physical_table_id: TableId,
+        tables: &[(TableId, TableName)],
+    ) -> Result<Vec<Vec<u8>>> {
+        let table_route_value = TableRouteValue::logical(physical_table_id);
+        let mut keys = Vec::with_capacity(tables.len() * 4);
+        for (table_id, table_name) in tables {
+            keys.extend(self.table_metadata_keys(
+                *table_id,
+                table_name,
+                &table_route_value,
+                &HashMap::new(),
+            )?);
+        }
+        Ok(keys)
+    }
+
