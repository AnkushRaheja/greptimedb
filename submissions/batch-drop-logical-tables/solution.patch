+    /// Submits and executes a drop logical tables task.
+    #[tracing::instrument(skip_all)]
+    pub async fn submit_drop_logical_table_tasks(
+        &self,
+        drop_table_tasks: Vec<DropTableTask>,
+        procedure_context: ProcedureContext,
+    ) -> Result<(ProcedureId, Option<Output>)> {
+        let context = self.create_context();
+
+        // Procedure locks are fixed at submission, so resolve the physical table
+        // from the first existing table. The procedure verifies that all the
+        // tables belong to it.
+        let table_name_keys = drop_table_tasks
+            .iter()
+            .map(|task| TableNameKey::new(&task.catalog, &task.schema, &task.table))
+            .collect::<Vec<_>>();
+        let first_table_id = self
+            .table_metadata_manager()
+            .table_name_manager()
+            .batch_get(table_name_keys)
+            .await?
+            .into_iter()
+            .flatten()
+            .map(|value| value.table_id())
+            .next();
+        let physical_table_id = match first_table_id {
+            Some(table_id) => Some(
+                self.table_metadata_manager()
+                    .table_route_manager()
+                    .get_physical_table_id(table_id)
+                    .await?,
+            ),
+            None => None,
+        };
+
+        let procedure =
+            DropLogicalTablesProcedure::new(drop_table_tasks, physical_table_id, context);
+
+        let procedure_with_id =
+            ProcedureWithId::with_random_id(Box::new(procedure)).with_context(procedure_context);
+
+        self.execute_procedure_and_wait(procedure_with_id).await
+    }
