+async fn submit(ddl_manager: &DdlManager, task: DdlTask) -> Result<SubmitDdlTaskResponse> {
+    ddl_manager
+        .submit_ddl_task(
+            ExecutorContext {
+                query_context: Some(QueryContext::default()),
+                ..Default::default()
+            },
+            SubmitDdlTaskRequest::new(task),
+        )
+        .await
+}
+
+/// The logical regions of the table, each paired with the datanode leading it.
+fn logical_regions(table_id: TableId) -> BTreeSet<(u64, RegionId)> {
+    (1..=NUM_REGIONS)
+        .map(|region_number| (region_number as u64, RegionId::new(table_id, region_number)))
+        .collect()
+}
+
+fn dropped_regions(received: &[ReceivedRegionRequest]) -> BTreeSet<(u64, RegionId)> {
+    received
+        .iter()
+        .filter(|(_, _, is_drop)| *is_drop)
+        .map(|(peer_id, region_id, _)| (*peer_id, *region_id))
+        .collect()
+}
+
+/// Asserts every region of the targets is dropped on its leader, and no request
+/// touches a region of any other table, including the physical table.
+fn assert_only_regions_of(received: &[ReceivedRegionRequest], targets: &[TableId]) {
+    let dropped = dropped_regions(received);
+    for table_id in targets {
+        let expected = logical_regions(*table_id);
+        assert!(
+            expected.is_subset(&dropped),
+            "regions of table {table_id} are not dropped, expected: {expected:?}, dropped: {dropped:?}"
+        );
+    }
+    let targets = targets.iter().copied().collect::<HashSet<_>>();
+    for (peer_id, region_id, is_drop) in received {
+        assert!(
+            targets.contains(&region_id.table_id()),
+            "unexpected region request (drop: {is_drop}) to datanode {peer_id} for region {region_id}"
+        );
+    }
+}
+
+/// Waits until the procedure is finished, returns its final state.
+async fn wait_finished(procedure_manager: &ProcedureManagerRef, id: ProcedureId) -> ProcedureState {
+    let finished =
+        |state: &ProcedureState| state.is_done() || state.is_failed() || state.is_poisoned();
+    let Some(mut watcher) = procedure_manager.procedure_watcher(id) else {
+        return procedure_manager
+            .procedure_state(id)
+            .await
+            .unwrap()
+            .unwrap();
+    };
+    loop {
+        let state = watcher.borrow_and_update().clone();
+        if finished(&state) {
+            return state;
+        }
+        if watcher.changed().await.is_err() {
+            return procedure_manager
+                .procedure_state(id)
+                .await
+                .unwrap()
+                .unwrap();
+        }
+    }
+}
