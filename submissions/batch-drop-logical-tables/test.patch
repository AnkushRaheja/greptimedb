+/// A region request received by a datanode: `(datanode id, region id, is drop)`.
+/// Region close requests are recorded with `is drop == false`.
+type ReceivedRegionRequest = (u64, RegionId, bool);
+
+/// Records drop and close region requests.
+///
+/// When holding, destructive region requests never complete, which models
+/// a datanode that has not answered yet when metasrv goes down.
+#[derive(Clone, Default)]
+struct RegionRequestRecorder {
+    received: Arc<Mutex<Vec<ReceivedRegionRequest>>>,
+    holding: Arc<AtomicBool>,
+    held_tx: Option<mpsc::Sender<()>>,
+}
+
+impl RegionRequestRecorder {
+    fn holding(held_tx: mpsc::Sender<()>) -> Self {
+        Self {
+            received: Default::default(),
+            holding: Arc::new(AtomicBool::new(true)),
+            held_tx: Some(held_tx),
+        }
+    }
+
+    fn release(&self) {
+        self.holding.store(false, Ordering::SeqCst);
+    }
+
+    fn take(&self) -> Vec<ReceivedRegionRequest> {
+        std::mem::take(&mut *self.received.lock().unwrap())
+    }
+
+    fn received(&self) -> Vec<ReceivedRegionRequest> {
+        self.received.lock().unwrap().clone()
+    }
+}
+
+fn destructive_region_requests(request: &RegionRequest) -> Vec<(RegionId, bool)> {
+    match &request.body {
+        Some(region_request::Body::Drop(drop)) => vec![(RegionId::from_u64(drop.region_id), true)],
+        Some(region_request::Body::Drops(drops)) => drops
+            .requests
+            .iter()
+            .map(|drop| (RegionId::from_u64(drop.region_id), true))
+            .collect(),
+        Some(region_request::Body::Close(close)) => {
+            vec![(RegionId::from_u64(close.region_id), false)]
+        }
+        _ => vec![],
+    }
+}
+
+#[async_trait::async_trait]
+impl MockDatanodeHandler for RegionRequestRecorder {
+    async fn handle(&self, peer: &Peer, request: RegionRequest) -> Result<RegionResponse> {
+        let requests = destructive_region_requests(&request);
+        if !requests.is_empty() && self.holding.load(Ordering::SeqCst) {
+            if let Some(held_tx) = &self.held_tx {
+                let _ = held_tx.try_send(());
+            }
+            std::future::pending::<()>().await;
+        }
+        self.received.lock().unwrap().extend(
+            requests
+                .into_iter()
+                .map(|(region_id, is_drop)| (peer.id, region_id, is_drop)),
+        );
+        Ok(RegionResponse::new(0))
+    }
+
+    async fn handle_query(
+        &self,
+        _peer: &Peer,
+        _request: QueryRequest,
+    ) -> Result<SendableRecordBatchStream> {
+        unreachable!()
+    }
+}
