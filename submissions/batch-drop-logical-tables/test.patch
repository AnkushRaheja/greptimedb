+#[tokio::test(flavor = "multi_thread")]
+async fn test_batch_drop_logical_tables_recovers_after_restart() {
+    let (held_tx, mut held_rx) = mpsc::channel(16);
+    let env = TestEnv::new(RegionRequestRecorder::holding(held_tx));
+    let physical_table_id = env.create_physical_table("phy").await;
+    let a = env.create_logical_table(physical_table_id, "a").await;
+    let b = env.create_logical_table(physical_table_id, "b").await;
+    let c = env.create_logical_table(physical_table_id, "c").await;
+    let survivors = env
+        .metadata_snapshot(&[(physical_table_id, "phy"), (c, "c")])
+        .await;
+
+    let (ddl_manager, procedure_manager) = env.start_ddl_manager().await;
+    let ddl_manager = Arc::new(ddl_manager);
+    let mut submission = tokio::spawn({
+        let ddl_manager = ddl_manager.clone();
+        async move {
+            submit(
+                &ddl_manager,
+                DdlTask::DropLogicalTables(vec![
+                    drop_task("a", a, false),
+                    drop_task("b", b, false),
+                ]),
+            )
+            .await
+        }
+    });
+
+    // Waits until the batch is dropping regions and no datanode has answered yet.
+    tokio::time::timeout(STALL_TIMEOUT, async {
+        tokio::select! {
+            held = held_rx.recv() => held.unwrap(),
+            result = &mut submission => {
+                panic!("the batch finished before any region is dropped: {result:?}")
+            }
+        }
+    })
+    .await
+    .expect("the batch never reached the datanodes");
+    procedure_manager.stop().await.unwrap();
+    let _ = tokio::time::timeout(STALL_TIMEOUT, submission)
+        .await
+        .expect("the submission is not finished after stopping the procedure manager");
+    drop(ddl_manager);
+
+    env.datanode.release();
+    assert!(env.datanode.received().is_empty());
+
+    // Restarts on the persisted procedure state.
+    let (ddl_manager, procedure_manager) = env.start_ddl_manager().await;
+    let procedures = procedure_manager.list_procedures().await.unwrap();
+    assert!(!procedures.is_empty(), "no procedure is recovered");
+    for procedure in procedures {
+        let state = tokio::time::timeout(
+            STALL_TIMEOUT,
+            wait_finished(&procedure_manager, procedure.id),
+        )
+        .await
+        .expect("the recovered procedure is stalled");
+        assert!(
+            state.is_done(),
+            "recovered procedure {} ({}) is not done: {state:?}",
+            procedure.id,
+            procedure.type_name
+        );
+    }
+
+    env.assert_dropped(a, "a").await;
+    env.assert_dropped(b, "b").await;
+    assert_eq!(
+        env.metadata_snapshot(&[(physical_table_id, "phy"), (c, "c")])
+            .await,
+        survivors
+    );
+    assert_only_regions_of(&env.datanode.take(), &[a, b]);
+    env.assert_caches_invalidated(&[(a, "a"), (b, "b")]);
+
+    // Dropping another logical table of the same physical table keeps working.
+    submit(&ddl_manager, DdlTask::DropTable(drop_task("c", c, false)))
+        .await
+        .unwrap();
+    env.assert_dropped(c, "c").await;
+    assert!(env.table_name_exists("phy").await);
+}
