+#!/usr/bin/env bash
+# Runs the common-meta unit tests covering logical table DDL.
+#
+# Usage: ./test.sh <base|new> [junit-output-path]
+#
+#   base  existing common-meta unit tests (regression suite)
+#   new   batch drop of logical tables tests
+#
+# The JUnit report is written to the second argument, or to $JUNIT_OUTPUT, or
+# to test-results/<mode>.xml. Requires cargo-nextest; installs nothing.
+
+set -uo pipefail
+
+MODE="${1:-}"
+case "$MODE" in
+    base)
+        FILTER='package(common-meta) & kind(lib) & !test(/^ddl::tests::batch_drop_logical_tables::/)'
+        ;;
+    new)
+        FILTER='package(common-meta) & kind(lib) & test(/^ddl::tests::batch_drop_logical_tables::/)'
+        ;;
+    *)
+        echo "usage: $0 <base|new> [junit-output-path]" >&2
+        exit 2
+        ;;
+esac
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd "$ROOT" || exit 2
+
+JUNIT_OUTPUT="${2:-${JUNIT_OUTPUT:-$ROOT/test-results/$MODE.xml}}"
+mkdir -p "$(dirname "$JUNIT_OUTPUT")"
+PROFILE="junit-report"
+WORK_DIR="$(mktemp -d)"
+trap 'rm -rf "$WORK_DIR"' EXIT
+
+cat > "$WORK_DIR/nextest.toml" <<EOF
+[store]
+dir = "$WORK_DIR/store"
+
+[profile.$PROFILE]
+retries = 0
+fail-fast = false
+slow-timeout = { period = "60s", terminate-after = 5 }
+
+[profile.$PROFILE.junit]
+path = "junit.xml"
+store-success-output = false
+store-failure-output = true
+EOF
+
+xml_escape() {
+    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
+}
+
+# Writes a failing report when no test could run, e.g. the build failed.
+write_fallback_junit() {
+    local reason="$1" log="$2"
+    {
+        echo '<?xml version="1.0" encoding="UTF-8"?>'
+        echo "<testsuites name=\"$MODE\" tests=\"1\" failures=\"1\" errors=\"0\">"
+        echo "  <testsuite name=\"common-meta\" tests=\"1\" failures=\"1\" errors=\"0\">"
+        echo "    <testcase classname=\"common-meta\" name=\"$MODE::$reason\">"
+        echo "      <failure message=\"$reason\" type=\"$reason\">"
+        tail -n 200 "$log" | xml_escape
+        echo "      </failure>"
+        echo "    </testcase>"
+        echo "  </testsuite>"
+        echo "</testsuites>"
+    } > "$JUNIT_OUTPUT"
+}
+
+NEXTEST_ARGS=(
+    -p common-meta
+    --lib
+    --config-file "$WORK_DIR/nextest.toml"
+    --profile "$PROFILE"
+    -E "$FILTER"
+)
+
+# Builds the tests and checks that the selected tests exist.
+if ! cargo nextest list "${NEXTEST_ARGS[@]}" > "$WORK_DIR/list.log" 2>&1; then
+    cat "$WORK_DIR/list.log" >&2
+    write_fallback_junit "build" "$WORK_DIR/list.log"
+    echo "test.sh: failed to build or list the tests" >&2
+    exit 1
+fi
+NUM_TESTS="$(grep -c '^common-meta ' "$WORK_DIR/list.log")"
+echo "test.sh: mode=$MODE selected $NUM_TESTS tests"
+if [ "$NUM_TESTS" -eq 0 ]; then
+    cat "$WORK_DIR/list.log" >&2
+    write_fallback_junit "discovery" "$WORK_DIR/list.log"
+    echo "test.sh: no test is selected" >&2
+    exit 1
+fi
+
+REPORT="$WORK_DIR/store/$PROFILE/junit.xml"
+rm -f "$REPORT"
+cargo nextest run "${NEXTEST_ARGS[@]}" \
+    --retries 0 \
+    --no-fail-fast \
+    --test-threads "${TEST_THREADS:-4}" 2>&1 | tee "$WORK_DIR/run.log"
+STATUS="${PIPESTATUS[0]}"
+
+if [ -s "$REPORT" ]; then
+    cp "$REPORT" "$JUNIT_OUTPUT"
+else
+    write_fallback_junit "run" "$WORK_DIR/run.log"
+    [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+echo "test.sh: mode=$MODE status=$STATUS junit=$JUNIT_OUTPUT"
+exit "$STATUS"
