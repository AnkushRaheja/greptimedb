+#[tokio::test]
+async fn test_batch_drop_logical_tables_rejects_different_physical_tables() {
+    let env = TestEnv::new(RegionRequestRecorder::default());
+    let physical_table_id = env.create_physical_table("phy").await;
+    let other_physical_table_id = env.create_physical_table("other_phy").await;
+    let a = env.create_logical_table(physical_table_id, "a").await;
+    let b = env.create_logical_table(physical_table_id, "b").await;
+    let x = env.create_logical_table(other_physical_table_id, "x").await;
+    let (ddl_manager, _procedure_manager) = env.start_ddl_manager().await;
+    let tables = [
+        (physical_table_id, "phy"),
+        (other_physical_table_id, "other_phy"),
+        (a, "a"),
+        (b, "b"),
+        (x, "x"),
+    ];
+    let before = env.metadata_snapshot(&tables).await;
+
+    for tasks in [
+        vec![drop_task("a", a, false), drop_task("x", x, false)],
+        vec![
+            drop_task("x", x, false),
+            drop_task("a", a, false),
+            drop_task("b", b, false),
+        ],
+    ] {
+        submit(&ddl_manager, DdlTask::DropLogicalTables(tasks))
+            .await
+            .unwrap_err();
+        assert_eq!(env.metadata_snapshot(&tables).await, before);
+        assert!(dropped_regions(&env.datanode.take()).is_empty());
+    }
+
+    // The rejected batches leave the tables droppable.
+    submit(
+        &ddl_manager,
+        DdlTask::DropLogicalTables(vec![drop_task("a", a, false), drop_task("b", b, false)]),
+    )
+    .await
+    .unwrap();
+    env.assert_dropped(a, "a").await;
+    env.assert_dropped(b, "b").await;
+    assert!(env.table_name_exists("x").await);
+    assert_only_regions_of(&env.datanode.take(), &[a, b]);
+}
