+#[tokio::test]
+async fn test_batch_drop_logical_tables() {
+    let env = TestEnv::new(RegionRequestRecorder::default());
+    let physical_table_id = env.create_physical_table("phy").await;
+    let a = env.create_logical_table(physical_table_id, "a").await;
+    let b = env.create_logical_table(physical_table_id, "b").await;
+    let c = env.create_logical_table(physical_table_id, "c").await;
+    let (ddl_manager, _procedure_manager) = env.start_ddl_manager().await;
+    let survivors = env
+        .metadata_snapshot(&[(physical_table_id, "phy"), (c, "c")])
+        .await;
+
+    submit(
+        &ddl_manager,
+        DdlTask::DropLogicalTables(vec![drop_task("a", a, false), drop_task("b", b, false)]),
+    )
+    .await
+    .unwrap();
+
+    env.assert_dropped(a, "a").await;
+    env.assert_dropped(b, "b").await;
+    assert_eq!(
+        env.metadata_snapshot(&[(physical_table_id, "phy"), (c, "c")])
+            .await,
+        survivors
+    );
+    assert_only_regions_of(&env.datanode.take(), &[a, b]);
+
+    // Dropping another logical table of the same physical table keeps working.
+    submit(&ddl_manager, DdlTask::DropTable(drop_task("c", c, false)))
+        .await
+        .unwrap();
+    env.assert_dropped(c, "c").await;
+    assert_only_regions_of(&env.datanode.take(), &[c]);
+    assert!(env.table_name_exists("phy").await);
+}
