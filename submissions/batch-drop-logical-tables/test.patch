+}
+
+impl TestEnv {
+    fn new(datanode: RegionRequestRecorder) -> Self {
+        let node_manager = Arc::new(MockDatanodeManager::new(datanode.clone()));
+        let kv_backend: KvBackendRef = Arc::new(MemoryKvBackend::new());
+        let mut ddl_context = new_ddl_context_with_kv_backend(node_manager, kv_backend.clone());
+        let cache_invalidator = Arc::new(CacheInvalidationRecorder::default());
+        ddl_context.cache_invalidator = cache_invalidator.clone();
+
+        Self {
+            ddl_context,
+            kv_backend,
+            state_kv_backend: Arc::new(MemoryKvBackend::new()),
+            datanode,
+            cache_invalidator,
+        }
+    }
+
+    /// Starts a procedure manager on the persisted procedure state of this env.
+    async fn start_ddl_manager(&self) -> (DdlManager, ProcedureManagerRef) {
+        let state_store = Arc::new(KvStateStore::new(self.state_kv_backend.clone()));
+        let procedure_manager: ProcedureManagerRef = Arc::new(LocalManager::new(
+            ManagerConfig::default(),
+            state_store,
+            Arc::new(InMemoryPoisonStore::default()),
+            None,
+            None,
+        ));
+        let ddl_manager = DdlManager::new(
+            self.ddl_context.clone(),
+            procedure_manager.clone(),
+            Arc::new(NoopRepartitionProcedureFactory),
+        );
+        ddl_manager.register_loaders().unwrap();
+        procedure_manager.start().await.unwrap();
+        (ddl_manager, procedure_manager)
+    }
+
+    /// Creates a table with [NUM_REGIONS] regions, region `n` is led by datanode `n`.
+    async fn create_table_with_regions(&self, mut task: CreateTableTask) -> TableId {
+        let TableMetadata { table_id, .. } = self
+            .ddl_context
+            .table_metadata_allocator
+            .create(&task)
+            .await
+            .unwrap();
+        task.set_table_id(table_id);
+        let region_routes = (1..=NUM_REGIONS)
+            .map(|region_number| RegionRoute {
+                region: Region::new_test(RegionId::new(table_id, region_number)),
+                leader_peer: Some(Peer::empty(region_number as u64)),
+                follower_peers: vec![],
+                leader_state: None,
+                leader_down_since: None,
+                write_route_policy: None,
+            })
+            .collect();
+        create_physical_table_metadata(
+            &self.ddl_context,
+            task.table_info,
+            TableRouteValue::physical(region_routes),
+        )
+        .await;
+        table_id
+    }
+
+    async fn create_physical_table(&self, name: &str) -> TableId {
+        self.create_table_with_regions(test_create_physical_table_task(name))
+            .await
+    }
+
+    async fn create_logical_table(&self, physical_table_id: TableId, name: &str) -> TableId {
+        create_logical_table(self.ddl_context.clone(), physical_table_id, name).await
+    }
+
+    async fn table_name_exists(&self, name: &str) -> bool {
+        self.ddl_context
+            .table_metadata_manager
+            .table_name_manager()
+            .exists(TableNameKey::new(
+                DEFAULT_CATALOG_NAME,
+                DEFAULT_SCHEMA_NAME,
+                name,
+            ))
+            .await
+            .unwrap()
+    }
+
+    async fn assert_dropped(&self, table_id: TableId, name: &str) {
+        assert!(
+            !self.table_name_exists(name).await,
+            "table {name} should be dropped"
+        );
+        let manager = &self.ddl_context.table_metadata_manager;
+        assert!(
+            manager
+                .table_info_manager()
+                .get(table_id)
+                .await
+                .unwrap()
+                .is_none(),
+            "table info of {name} should be removed"
+        );
+        assert!(
+            manager
+                .table_route_manager()
+                .table_route_storage()
+                .get(table_id)
+                .await
+                .unwrap()
+                .is_none(),
+            "table route of {name} should be removed"
+        );
+    }
+
+    /// Returns the raw name, info and route values of the tables.
+    async fn metadata_snapshot(&self, tables: &[(TableId, &str)]) -> Vec<Option<Vec<u8>>> {
+        let mut snapshot = Vec::with_capacity(tables.len() * 3);
+        for (table_id, name) in tables {
+            for key in [
+                TableNameKey::new(DEFAULT_CATALOG_NAME, DEFAULT_SCHEMA_NAME, name).to_bytes(),
+                TableInfoKey::new(*table_id).to_bytes(),
+                TableRouteKey::new(*table_id).to_bytes(),
+            ] {
+                let value = self.kv_backend.get(&key).await.unwrap().map(|kv| kv.value);
+                snapshot.push(value);
+            }
+        }
+        snapshot
+    }
+
+    fn invalidated_caches(&self) -> Vec<CacheIdent> {
+        self.cache_invalidator.invalidated.lock().unwrap().clone()
+    }
+
+    fn assert_caches_invalidated(&self, tables: &[(TableId, &str)]) {
+        let invalidated = self.invalidated_caches();
+        for (table_id, name) in tables {
+            assert!(
+                invalidated.contains(&CacheIdent::TableId(*table_id)),
+                "cache of table id {table_id} is not invalidated, invalidated: {invalidated:?}"
+            );
+            let table_name = TableName::new(DEFAULT_CATALOG_NAME, DEFAULT_SCHEMA_NAME, *name);
+            assert!(
+                invalidated.contains(&CacheIdent::TableName(table_name)),
+                "cache of table name {name} is not invalidated, invalidated: {invalidated:?}"
+            );
+        }
+    }
+}
+
+fn drop_task(name: &str, table_id: TableId, drop_if_exists: bool) -> DropTableTask {
+    DropTableTask {
+        catalog: DEFAULT_CATALOG_NAME.to_string(),
+        schema: DEFAULT_SCHEMA_NAME.to_string(),
+        table: name.to_string(),
+        table_id,
+        drop_if_exists,
+    }
+}
