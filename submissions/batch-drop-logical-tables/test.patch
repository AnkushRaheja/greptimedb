+#[derive(Default)]
+struct CacheInvalidationRecorder {
+    invalidated: Mutex<Vec<CacheIdent>>,
+}
+
+#[async_trait::async_trait]
+impl CacheInvalidator for CacheInvalidationRecorder {
+    async fn invalidate(&self, _ctx: &Context, caches: &[CacheIdent]) -> Result<()> {
+        self.invalidated.lock().unwrap().extend_from_slice(caches);
+        Ok(())
+    }
+
+    fn invalidate_all(&self) -> Result<()> {
+        // The recorder owns no cache state.
+        Ok(())
+    }
+}
